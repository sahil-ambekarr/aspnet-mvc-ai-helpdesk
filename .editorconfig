root = true

[*]
indent_style = space
insert_final_newline = true
charset = utf-8

[*.{cs,cshtml}]
indent_size = 4

[*.{json,yml,yaml,csproj,props,js,css}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[src/Helpdesk.Web/Data/Migrations/*.cs]
generated_code = true
