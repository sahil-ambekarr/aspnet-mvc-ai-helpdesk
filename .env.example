# Copy to .env for docker compose, or export these in your shell for `dotnet run`.
# ASP.NET Core does not read .env files on its own.

# ollama (default) | claude | mock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Claude is enabled only when this is set. Leave empty otherwise.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Upper bound for one AI call including retries (seconds). CPU-only Ollama is slow.
LLM_TIMEOUT_SECONDS=300

# docker compose only: SQL Server sa password (min 8 chars, mixed case, digit, symbol)
MSSQL_SA_PASSWORD=
