@model DashboardViewModel
@inject TimeProvider Clock
@{
    ViewData["Title"] = "Dashboard";
    var now = Clock.GetUtcNow().UtcDateTime;
    var statusMax = Math.Max(1, Model.ByStatus.Max(r => r.Count));
    var priorityMax = Math.Max(1, Model.ByPriority.Max(r => r.Count));
}
<div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">Dashboard</h1>
        <div class="text-muted small">@(Model.IsAgentView ? "All tickets" : "Your tickets")</div>
    </div>
    <a class="btn btn-primary" asp-controller="Tickets" asp-action="Create">Raise a ticket</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a class="kpi card shadow-sm h-100 text-decoration-none" asp-controller="Tickets" asp-action="Index">
            <div class="card-body"><div class="kpi-label">Open tickets</div><div class="kpi-value">@Model.OpenCount</div></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        @if (Model.IsAgentView)
        {
            <a class="kpi card shadow-sm h-100 text-decoration-none" asp-controller="Tickets" asp-action="Index" asp-route-scope="unassigned">
                <div class="card-body"><div class="kpi-label">Unassigned</div><div class="kpi-value">@Model.UnassignedCount</div></div>
            </a>
        }
        else
        {
            <div class="kpi card shadow-sm h-100">
                <div class="card-body"><div class="kpi-label">Not yet picked up</div><div class="kpi-value">@Model.UnassignedCount</div></div>
            </div>
        }
    </div>
    <div class="col-6 col-lg-3">
        <a class="kpi card shadow-sm h-100 text-decoration-none" asp-controller="Tickets" asp-action="Index" asp-route-priority="Urgent">
            <div class="card-body"><div class="kpi-label">Urgent and open</div><div class="kpi-value @(Model.UrgentOpenCount > 0 ? "text-danger" : "")">@Model.UrgentOpenCount</div></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi card shadow-sm h-100">
            <div class="card-body"><div class="kpi-label">Resolved in last 7 days</div><div class="kpi-value">@Model.ResolvedLast7Days</div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Tickets by status</div>
            <div class="card-body">
                @foreach (var row in Model.ByStatus)
                {
                    <a class="bar-row text-decoration-none" asp-controller="Tickets" asp-action="Index" asp-route-status="@row.Label">
                        <span class="bar-label">@Ui.Label(row.Label)</span>
                        <span class="bar-track"><span class="bar-fill" style="width:@(row.Count * 100 / statusMax)%"></span></span>
                        <span class="bar-value">@row.Count</span>
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Open tickets by priority</div>
            <div class="card-body">
                @foreach (var row in Model.ByPriority)
                {
                    <a class="bar-row text-decoration-none" asp-controller="Tickets" asp-action="Index" asp-route-priority="@row.Label">
                        <span class="bar-label">@row.Label</span>
                        <span class="bar-track"><span class="bar-fill bar-fill-alt" style="width:@(row.Count * 100 / priorityMax)%"></span></span>
                        <span class="bar-value">@row.Count</span>
                    </a>
                }
                @if (Model.IsAgentView && Model.AiUsage.Count > 0)
                {
                    <hr />
                    <div class="small text-muted mb-1">AI assistant calls (audit log)</div>
                    <div class="d-flex flex-wrap gap-3 small">
                        @foreach (var u in Model.AiUsage)
                        {
                            <span><span class="fw-semibold">@u.Count</span> @u.Label</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Recently updated</span>
        <a asp-controller="Tickets" asp-action="Index" class="small">All tickets</a>
    </div>
    <div class="list-group list-group-flush">
        @foreach (var t in Model.Recent)
        {
            <a class="list-group-item list-group-item-action d-flex flex-wrap gap-2 align-items-center" asp-controller="Tickets" asp-action="Details" asp-route-id="@t.Id">
                <span class="text-muted small ticket-id">#@t.Id</span>
                <span class="flex-grow-1">@t.Title</span>
                <partial name="_PriorityBadge" model="t.Priority" />
                <partial name="_StatusBadge" model="t.Status" />
                <span class="text-muted small">@Ui.Ago(t.UpdatedAt, now)</span>
            </a>
        }
        @if (Model.Recent.Count == 0)
        {
            <div class="list-group-item text-muted">No tickets yet.</div>
        }
    </div>
</div>
