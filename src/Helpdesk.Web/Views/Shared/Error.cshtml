@{
    ViewData["Title"] = "Error";
}
<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h4 text-danger">Something went wrong</h1>
        <p class="mb-1">The request could not be completed. Please try again.</p>
        <p class="small text-muted mb-0">Request ID: <code>@ViewData["RequestId"]</code></p>
    </div>
</div>
