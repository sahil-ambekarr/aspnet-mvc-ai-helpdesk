<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lakeview IT Helpdesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark app-navbar">
            <div class="container-xl">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">LV</span> IT Helpdesk
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        @{ var controller = ViewContext.RouteData.Values["controller"]?.ToString(); }
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @(controller == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index">Tickets</a></li>
                            <li class="nav-item"><a class="nav-link @(controller == "Kb" ? "active" : "")" asp-controller="Kb" asp-action="Index">Knowledge base</a></li>
                        </ul>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <a class="btn btn-sm btn-light" asp-controller="Tickets" asp-action="Create">New ticket</a>
                            <span class="navbar-text small">
                                @User.Identity!.Name
                                <span class="badge rounded-pill @(User.IsAgent() ? "text-bg-warning" : "text-bg-secondary") ms-1">@(User.IsAgent() ? Roles.Agent : Roles.Requester)</span>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <main role="main" class="container-xl py-4">
        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @flash
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>
    <footer class="container-xl pb-4 small text-muted">
        Lakeview Components is a fictional company. Portfolio demo with seeded data.
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
