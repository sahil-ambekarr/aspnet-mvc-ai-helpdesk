{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "SqlServer": "",
    "Sqlite": "Data Source=helpdesk.db"
  },
  "Seed": {
    "Enabled": false
  },
  "Llm": {
    "Provider": "ollama",
    "TimeoutSeconds": 300,
    "AttemptTimeoutSeconds": 240,
    "MaxRetryAttempts": 2,
    "RetryBaseDelayMs": 1000,
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.2",
      "Temperature": 0.2,
      "NumCtx": 4096
    },
    "Claude": {
      "Model": "claude-haiku-5-5",
      "MaxTokens": 1024
    }
  }
}
